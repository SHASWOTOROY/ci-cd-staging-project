{
  "name": "onenote",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "node server/src/setup-local.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm run dev --prefix client",
    "dev": "npm run setup && npx concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
